<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.suanla.relayq.autoconfigure.host.HostRecordMapper">
    <insert id="insert">
        INSERT INTO host_record (id, name) VALUES (1, #{name})
    </insert>
    <select id="selectName" resultType="string">
        SELECT name FROM host_record WHERE id = 1
    </select>
</mapper>
